# Copy this file to .env and replace the placeholder values.
ADMIN_EMAIL=admin@coffee.com

# Set ONE of the following. Prefer ADMIN_PASSWORD_HASH in production.
ADMIN_PASSWORD=change-me-to-a-strong-password
# ADMIN_PASSWORD_HASH=$2a$12$replace.with.a.bcrypt.hash

# Long random string used to sign the admin session cookie.
SESSION_SECRET=replace-with-a-long-random-secret

# Session lifetime in hours.
SESSION_HOURS=8

PORT=4000

# Set to true only when the site is served over HTTPS.
COOKIE_SECURE=false

NODE_ENV=production
